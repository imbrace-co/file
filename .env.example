# Environment Variables Template

# Server Configuration
PORT=8866
NODE_ENV=development

# Database Configuration
# Choose one of: mongodb, postgres, mysql, sqlite
DB_TYPE=mongodb

# MongoDB (if DB_TYPE=mongodb)
MONGO_URI=mongodb://localhost:27017/fileservice

# PostgreSQL (if DB_TYPE=postgres)
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=your_password
# DB_NAME=fileservice

# MySQL (if DB_TYPE=mysql)
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=your_password
# DB_NAME=fileservice

# SQLite (if DB_TYPE=sqlite)
# DB_PATH=./data/fileservice.db

# Storage Configuration
# Option 1: Local File Storage (recommended for development)
LOCAL_PATH=./uploads

# Option 2: AWS S3 Storage (comment out LOCAL_PATH to use S3)
# AWS_ACCESS_KEY_ID=your_access_key_id
# AWS_SECRET_ACCESS_KEY=your_secret_access_key
# AWS_REGION=us-east-1
# S3_BUCKET_NAME=your-bucket-name
